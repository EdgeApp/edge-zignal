# Copy to .deploy.local.env; replace placeholders with private values.
ZIGNAL_SSH_TARGET='SSH_USER@SERVER_HOST'
ZIGNAL_APP_DIR='/absolute/path/to/checkout'
ZIGNAL_APP_USER='SERVICE_USER'
ZIGNAL_SERVICE='SERVICE_NAME'
ZIGNAL_BACKUP_DIR='/absolute/path/outside/checkout'
ZIGNAL_DROPLET_ID='DROPLET_ID'
ZIGNAL_INTERCOM_CREDENTIALS='/absolute/path/to/private/credentials.env'
